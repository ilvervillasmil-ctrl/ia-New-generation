# tests/test_omega_action_collapse.py

from unittest import TestCase
from math import log
import formulas as ω

class TestOmegaActionCollapse(TestCase):
    """
    TEST Ω‑COLLAPSE:
    Fuerza máxima sobre la fórmula de la acción universal.
    Verifica que:
      - Mientras el sistema está vivo (latido > 0), omega_action > 0.
      - Cuando el sistema colapsa (latido = 0, dnu = 0), omega_action = 0.
    """

    def test_collapse_when_motor_stops(self):
        """
        Escenario extremo: ciclo de coche acelerando, frenando y apagando.
        """
        # RPM típicos de un coche (1.000 a 4.500 RPM, luego apagado)
        rpm = [1000, 1500, 2500, 3500, 4500, 3000, 2000, 1500, 1000, 0]

        # Convertir a rps (latido por segundo)
        nu = [r / 60.0 for r in rpm]

        # 3. Calcular dnu = derivada de nu
        dnu = [0]  # dnu[0] indeterminado
        for i in range(1, len(nu) - 1):
            # dnu ≈ (nu[i+1] - nu[i-1]) / 2
            dnu.append((nu[i+1] - nu[i-1]) / 2)
        dnu.append(0)  # dnu[final] indeterminado

        # Ajuste: S_MAX = ln(5) para 5 bins
        S_MAX = log(5, 2)

        # Para simular realidad: H(S) > 0 cuando el motor está encendido
        for i in range(len(nu)):
            H = 0.8 if nu[i] > 0 else 0.0

            A_omega = ω.omega_action(H, S_MAX, nu[i], dnu[i])

            # Asegura que cuando el motor está encendido, la acción > 0
            if nu[i] > 0:
                self.assertGreater(A_omega, 0,
                                   f"Omega action debe > 0 en ciclo {i} " +
                                   f"(nu={nu[i]:.2f}, dnu={dnu[i]:.2f}, A={A_omega:.4f})")

            # Asegura que cuando el motor apaga, la acción = 0
            if nu[i] == 0 and dnu[i] == 0:
                self.assertAlmostEqual(A_omega, 0.0, places=4,
                                       msg=f"Omega action debe ser 0 " +
                                           f"en colapso total (nu={nu[i]}, dnu={dnu[i]}, A={A_omega:.4f})")

    def test_cannot_recover_if_omega_zero(self):
        """
        No puede haber acción sin latido.
        Omega = 0 solo cuando el sistema colapsa.
        """
        # Colapso real: nu = 0, dnu = 0
        A = ω.omega_action(0.0, 1.0, 0.0, 0.0)
        self.assertAlmostEqual(A, 0.0, places=10,
                               msg=f"Omega action debe ser exactamente 0 en colapso total, pero A={A}")
